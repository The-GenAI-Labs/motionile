<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="color-scheme" content="light dark"><title>{{ subject }}</title></head>
<body style="font-family:Arial,sans-serif;line-height:1.6;margin:0;padding:32px"><main style="max-width:520px;margin:auto;border:1px solid;padding:24px"><h1 style="font-size:22px">{{ subject }}</h1><p>{{ message }}</p>{% if details %}<table role="presentation" style="width:100%;border-collapse:collapse;margin:16px 0">{% for label, value in details %}<tr><th scope="row" style="text-align:left;font-weight:normal;padding:8px 0;border-top:1px solid;opacity:.7">{{ label }}</th><td style="text-align:right;padding:8px 0;border-top:1px solid;font-family:monospace">{{ value }}</td></tr>{% endfor %}</table>{% endif %}{% if code %}<p style="font-family:monospace;font-size:32px;letter-spacing:6px">{{ code }}</p><p>This code expires in 5 minutes. Never share it with anyone.</p>{% endif %}{% if link %}<p><a href="{{ link }}">Download your export</a></p>{% endif %}{% if security_notice %}<p>If you did not request this, secure your account or contact support.</p>{% endif %}<p>Motionile</p></main></body></html>
