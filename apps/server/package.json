{
  "name": "@motionile/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "uv run uvicorn motionile.entrypoints.api:app --reload --port 8000 --no-server-header",
    "lint": "uv run ruff check . && uv run ruff format --check .",
    "lint:imports": "uv run lint-imports",
    "typecheck": "uv run pyright",
    "test:unit": "uv run pytest -m unit --cov --cov-report=term --cov-report=xml:coverage/unit.xml",
    "test:integration": "uv run pytest -m integration --cov --cov-report=term --cov-report=xml:coverage/integration.xml",
    "contract:generate": "uv run python -m motionile.scripts.export_openapi",
    "evals": "uv run python -m evals.run"
  }
}
